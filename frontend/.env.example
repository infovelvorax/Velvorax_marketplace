# ==============================================================================
# Velvorax Application Environment Variables Template
# Copy this file to `.env` or `.env.local` to override for local development
# NOTE: Only variables prefixed with VITE_ are exposed to the client-side bundle.
# ==============================================================================

# API Configuration
VITE_API_BASE_URL=https://api.velvorax.com/api/marketplace
VITE_API_TIMEOUT=15000

# Application Configuration
VITE_APP_NAME=Velvorax
VITE_APP_ENV=development

# Cloudinary Unsigned Browser Upload Configuration
# NEVER put CLOUDINARY_API_SECRET here - only unsigned public configuration is permitted in frontend
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=velvorax-marketplace/listings
